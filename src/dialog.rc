#include <windows.h>
#include "resource.h"

IDD_DIALOG DIALOGEX 0, 0, 192, 104
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Aslan"
FONT 9, "Segoe UI"
BEGIN
    ICON "", IDC_DIALOG_ICON, 10, 10, 20, 32, SS_ICON | SS_CENTERIMAGE
    LTEXT "", IDC_DIALOG_MESSAGE, 38, 14, 144, 24, SS_LEFT
    LTEXT "Open with:", IDC_STATIC, 10, 43, 48, 8
    COMBOBOX IDC_DIALOG_COMBO, 62, 40, 120, 90, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_TABSTOP | WS_VSCROLL
    CONTROL " ", IDC_DIALOG_FOOTER, "STATIC", SS_LEFT, 0, 72, 192, 32
    DEFPUSHBUTTON "Open", IDOK, 76, 80, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 132, 80, 50, 14
END
