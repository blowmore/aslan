#include <windows.h>
#include "resource.h"

IDD_DIALOG DIALOGEX 0, 0, 270, 104
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Open with Automation Studio"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_DIALOG_MESSAGE, 10, 10, 250, 24
    LTEXT "Open with:", IDC_STATIC, 10, 43, 48, 8
    COMBOBOX IDC_DIALOG_COMBO, 62, 40, 198, 90, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_TABSTOP | WS_VSCROLL
    DEFPUSHBUTTON "Open", IDOK, 154, 80, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 210, 80, 50, 14
END
